# Production environment template.
# Copy to `.env.production` on the server, then replace every CHANGE_ME_IN_PRODUCTION value.
#   cp .env.production.example .env.production
#
# All credential values below are placeholders — never commit real secrets.
# The app service consumes this file via `env_file`; docker compose also reads it
# for `${VAR}` interpolation when launched with `--env-file .env.production`.

APP_NAME="Bracketa"
APP_ENV=production
APP_KEY=CHANGE_ME_IN_PRODUCTION
# Generate a real key:  php artisan key:generate --show

APP_DEBUG=false
APP_URL=https://CHANGE_ME_IN_PRODUCTION_DOMAIN

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tournatak_laravel
DB_USERNAME=tournatak
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CHANGE_ME_IN_PRODUCTION_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_IN_PRODUCTION_SMTP_USER
MAIL_PASSWORD=CHANGE_ME_IN_PRODUCTION_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@CHANGE_ME_IN_PRODUCTION_DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# S3 backup destination (spatie/laravel-backup writes to the s3 disk)
AWS_ACCESS_KEY_ID=CHANGE_ME_IN_PRODUCTION
AWS_SECRET_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=CHANGE_ME_IN_PRODUCTION
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backup destination disk + failure notifications (config/backup.php)
BACKUP_DESTINATION_DISK=s3
BACKUP_NOTIFICATION_EMAIL=CHANGE_ME_IN_PRODUCTION_NOTIFICATION_EMAIL

VITE_APP_NAME="${APP_NAME}"

# MySQL container credentials — must match DB_* above for the same user.
# Consumed by docker-compose.prod.yml via ${VAR} interpolation.
MYSQL_DATABASE=tournatak_laravel
MYSQL_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION
MYSQL_USER=tournatak
MYSQL_PASSWORD=CHANGE_ME_IN_PRODUCTION

# nginx host port (optional)
APP_PORT=80
